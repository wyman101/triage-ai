{
  "name": "triage-ai",
  "version": "1.1.0",
  "description": "Multi-model code triage — run Claude, Gemini and Codex in parallel to analyze your codebase and merge their findings",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "triage-ai": "dist/cli.js",
    "triage": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepare": "node node_modules/typescript/bin/tsc 2>/dev/null || true",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "keywords": [
    "code-review",
    "triage",
    "claude",
    "gemini",
    "codex",
    "openai",
    "anthropic",
    "google",
    "ai",
    "multi-model",
    "static-analysis",
    "security-audit",
    "code-quality",
    "mcp",
    "model-context-protocol",
    "cursor",
    "windsurf",
    "cline",
    "linter",
    "bug-detection",
    "consensus",
    "llm"
  ],
  "author": {
    "name": "wyman101",
    "email": "wyman100@yahoo.com",
    "url": "https://github.com/wyman101"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyman101/triage-ai.git"
  },
  "bugs": {
    "url": "https://github.com/wyman101/triage-ai/issues"
  },
  "homepage": "https://github.com/wyman101/triage-ai",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "ora": "^8.0.0",
    "chalk": "^5.3.0",
    "which": "^5.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/which": "^3.0.0"
  }
}
